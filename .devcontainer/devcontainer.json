{
  "name": "3d-night",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code pnpm && (test -f package.json && pnpm install || true)",

  "postAttachCommand": {
    "welcome": "echo '\\n  3d-night dev container ready.\\n  Run: claude   (starts Claude Code)\\n  Run: pnpm dev  (starts Next.js on port 3000)\\n'"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "eamodio.gitlens",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n"
      }
    },
    "codespaces": {
      "openFiles": ["CLAUDE.md"]
    }
  }
}
